{
  "name": "dm3-console-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based training simulator modeled on the Yamaha DM3 digital mixing console",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-acceptance.mjs",
    "test:mobile": "node tests/e2e/mobile-smoke.mjs"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
